# ---------------------------------------------------------------------------
# Ortam değişkenleri örneği
# ---------------------------------------------------------------------------
# Kullanım: bu dosyayı `.env.local` olarak kopyalayın ve değerleri doldurun.
#   cp .env.example .env.local
#
# .env.local sürüm kontrolüne EKLENMEZ (.gitignore içinde). Gerçek/gizli
# değerleri yalnızca .env.local içine yazın, bu örnek dosyaya değil.
# ---------------------------------------------------------------------------

# Backend (cop_kamyonu_backend) API adresi.
# Tüm sunucu tarafı isteklerinin (login, araçlar, telemetri, konum...) hedefi.
# Sonda "/" OLMADAN yazın; yollar koda "/vehicles" gibi eklenir.
# Tanımlı değilse uygulama başlarken hata fırlatır (src/lib/api.ts).
# Örn. yerel geliştirme: http://localhost:3000
BACKEND_URL=--

# (İsteğe bağlı) MapTiler API anahtarı — https://maptiler.com adresinden ücretsiz
# hesapla alınır (~100k harita yüklemesi/ay ücretsiz). Tanımlıysa harita Google'a
# en yakın görünüm olan MapTiler Streets v2 stilini kullanır; boşsa/yoksa ücretsiz
# ve anahtarsız OpenFreeMap Bright stiline düşer (src/components/MapView.tsx).
# NEXT_PUBLIC_ öneki: değer tarayıcıya gömülür — anahtarı MapTiler panelinden
# alan adı (domain) kısıtlamasıyla korumanız önerilir.
NEXT_PUBLIC_MAPTILER_KEY=
